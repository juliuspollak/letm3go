# Leave blank for offline development. Only public client configuration belongs here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Browser Apple OAuth opt-in; the signed native iOS flow is independently enabled.
VITE_ENABLE_APPLE_AUTH=false
# Push remains disabled until provisioning and backend registration are ready.
VITE_ENABLE_PUSH=false
VITE_APNS_ENVIRONMENT=sandbox

# Enable only after approval/application of 20261025000000_private_backup.sql and live RLS testing.
VITE_ENABLE_PRIVATE_BACKUP=false
VITE_ENABLE_TESLA=false
