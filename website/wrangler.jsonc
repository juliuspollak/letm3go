{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letm3go-public",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": { "enabled": false }
}
