default_platform(:ios)
APP_IDENTIFIER = 'au.jpollak.journey'

def connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
    key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_BASE64'),
    is_key_content_base64: true
  )
end

platform :ios do
  desc 'Build a signed Letm3go IPA; does not upload'
  lane :package do
    version = get_version_number(xcodeproj: 'ios/App/App.xcodeproj', target: 'App')
    latest = latest_testflight_build_number(api_key: connect_key, app_identifier: APP_IDENTIFIER, version: version, initial_build_number: 0).to_i
    override = ENV.fetch('BUILD_NUMBER_OVERRIDE', '').strip
    UI.user_error!('Build override must be a positive integer') unless override.empty? || override.match?(/\A[1-9]\d*\z/)
    number = override.empty? ? latest + 1 : override.to_i
    UI.user_error!('Build number must exceed the latest TestFlight build') if number <= latest
    increment_build_number(build_number: number, xcodeproj: 'ios/App/App.xcodeproj')
    update_code_signing_settings(
      use_automatic_signing: false, path: 'ios/App/App.xcodeproj', targets: ['App'],
      build_configurations: ['Release'], team_id: ENV.fetch('APPLE_TEAM_ID'),
      bundle_identifier: APP_IDENTIFIER, code_sign_identity: 'Apple Distribution',
      profile_name: ENV.fetch('PROFILE_NAME'), profile_uuid: ENV.fetch('PROFILE_UUID')
    )
    build_app(
      project: 'ios/App/App.xcodeproj', scheme: 'App', configuration: 'Release',
      export_method: 'app-store', output_directory: '.build/release', output_name: 'Letm3go.ipa',
      archive_path: '.build/release/Letm3go.xcarchive',
      export_options: {method: 'app-store-connect', signingStyle: 'manual', teamID: ENV.fetch('APPLE_TEAM_ID'), provisioningProfiles: {APP_IDENTIFIER => ENV.fetch('PROFILE_UUID')}}
    )
    File.write('.build/release/build-number.txt', number.to_s)
  end

  desc 'Upload an explicitly approved IPA; no external distribution'
  lane :upload do
    UI.user_error!('Explicit upload approval is required') unless ENV['LETM3GO_UPLOAD_APPROVED'] == 'YES'
    upload_to_testflight(api_key: connect_key, app_identifier: APP_IDENTIFIER,
      ipa: '.build/release/Letm3go.ipa', skip_waiting_for_build_processing: true,
      distribute_external: false, changelog: ENV.fetch('RELEASE_NOTES', 'Manual GPS field testing'))
  end
end
