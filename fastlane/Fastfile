default_platform(:ios)
APP_IDENTIFIER = 'au.jpollak.journey'
REPOSITORY_ROOT = File.expand_path('..', __dir__)
PROJECT_FILE = File.join(REPOSITORY_ROOT, 'ios/App/App.xcodeproj/project.pbxproj')

def connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
    key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_BASE64'),
    is_key_content_base64: true
  )
end

platform :ios do
  desc 'Build a signed Letm3go IPA; does not upload'
  lane :package do
    version = get_version_number(xcodeproj: 'ios/App/App.xcodeproj', target: 'App')
    latest = latest_testflight_build_number(api_key: connect_key, app_identifier: APP_IDENTIFIER, version: version, initial_build_number: 0).to_i
    override = ENV.fetch('BUILD_NUMBER_OVERRIDE', '').strip
    UI.user_error!('Build override must be a positive integer') unless override.empty? || override.match?(/\A[1-9]\d*\z/)
    number = override.empty? ? [latest + 1, get_build_number(xcodeproj: 'ios/App/App.xcodeproj').to_i].max : override.to_i
    UI.user_error!('Build number must exceed the latest TestFlight build') if number <= latest
    sh('npm run release:check')
    # The commit is stamped into Info.plist (Letm3goCommit) so every diagnostic
    # export names the exact source a field test ran, not just the build number.
    commit = Dir.chdir(REPOSITORY_ROOT) do
      head = `git rev-parse --short=12 HEAD`.strip
      UI.user_error!('Unable to read the git commit for the build') if head.empty?
      # Bundler's vendor/bundle and .bundle (written by CI's Ruby setup) are tool
      # output, not source; any other change still marks the build dirty.
      `git status --porcelain -- . ':(exclude)vendor' ':(exclude).bundle'`.strip.empty? ? head : "#{head}-dirty"
    end
    original_project = File.binread(PROJECT_FILE)
    begin
    update_code_signing_settings(
      use_automatic_signing: false, path: 'ios/App/App.xcodeproj', targets: ['App'],
      build_configurations: ['Release'], team_id: ENV.fetch('APPLE_TEAM_ID'),
      bundle_identifier: APP_IDENTIFIER, code_sign_identity: 'Apple Distribution',
      profile_name: ENV.fetch('PROFILE_NAME'), profile_uuid: ENV.fetch('PROFILE_UUID')
    )
    FileUtils.rm_f(File.join(REPOSITORY_ROOT, '.build/release/Letm3go.manifest.json'))
    build_app(
      project: 'ios/App/App.xcodeproj', scheme: 'App', configuration: 'Release',
      export_method: 'app-store', xcargs: "CURRENT_PROJECT_VERSION=#{number} LETM3GO_COMMIT=#{commit}", output_directory: '.build/release', output_name: 'Letm3go.ipa',
      archive_path: '.build/release/Letm3go.xcarchive',
      export_options: {method: 'app-store-connect', signingStyle: 'manual', teamID: ENV.fetch('APPLE_TEAM_ID'), provisioningProfiles: {APP_IDENTIFIER => ENV.fetch('PROFILE_UUID')}}
    )
    File.write(File.join(REPOSITORY_ROOT, '.build/release/build-number.txt'), number.to_s)
    sh('python3', File.join(REPOSITORY_ROOT, 'scripts/validate-ipa.py'), File.join(REPOSITORY_ROOT, '.build/release/Letm3go.ipa'))
    ensure
      File.binwrite(PROJECT_FILE, original_project)
    end
  end

  desc 'Upload an explicitly approved IPA; no external distribution'
  lane :upload do
    UI.user_error!('Explicit upload approval is required') unless ENV['LETM3GO_UPLOAD_APPROVED'] == 'YES'
    UI.user_error!('Reviewed IPA manifest is missing') unless File.exist?(File.join(REPOSITORY_ROOT, '.build/release/Letm3go.manifest.json'))
    sh('python3', File.join(REPOSITORY_ROOT, 'scripts/validate-ipa.py'), File.join(REPOSITORY_ROOT, '.build/release/Letm3go.ipa'))
    upload_to_testflight(api_key: connect_key, app_identifier: APP_IDENTIFIER,
      ipa: File.join(REPOSITORY_ROOT, '.build/release/Letm3go.ipa'), skip_waiting_for_build_processing: true,
      distribute_external: false, notify_external_testers: false, changelog: ENV.fetch('RELEASE_NOTES', 'Manual GPS field testing'))
  end
end
