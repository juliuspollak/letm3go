{
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "deno": "^2.9.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "name": "letm3go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "supabase": "node scripts/supabase.mjs",
    "db:start": "npm run supabase -- start",
    "db:stop": "npm run supabase -- stop",
    "db:reset": "npm run supabase -- db reset --local",
    "db:lint": "npm run supabase -- db lint --local",
    "functions:serve": "npm run supabase -- functions serve",
    "ios:build": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath .build/ios -clonedSourcePackagesDirPath .build/SourcePackages CODE_SIGN_IDENTITY=- build",
    "ios:sync:production": "VITE_APNS_ENVIRONMENT=production npm run ios:sync",
    "supabase:check": "node scripts/check-supabase.mjs",
    "test:native": "mkdir -p .build && swiftc -module-cache-path .build/swift-test-cache ios/App/App/RecorderCore.swift tests/native/main.swift -o .build/recorder-tests && .build/recorder-tests",
    "ios:device": "bash scripts/install-iphone.sh",
    "check:edge": "node scripts/check-edge.mjs",
    "test:database": "vitest run tests/database"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
